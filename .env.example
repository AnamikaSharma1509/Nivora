# ==============================================================================
# YOUR LIFE, YOUR SERIES - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION & GENERAL CONFIG
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Your Life, Your Series"
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-this-in-production-to-a-super-secure-random-32-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Local dev default port 5433 (or 5432 depending on your system)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=your_life_your_series
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5433/your_life_your_series
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/your_life_your_series

# ------------------------------------------------------------------------------
# CACHE & BACKGROUND TASK QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# MEDIA STORAGE (Local or S3/R2)
# ------------------------------------------------------------------------------
# Options: local | s3 | r2
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# AWS S3 / Cloudflare R2 credentials (when STORAGE_BACKEND=s3 or r2)
AWS_ACCESS_KEY_ID=placeholder_access_key
AWS_SECRET_ACCESS_KEY=placeholder_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-life-your-series-media
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# AI STORY GENERATION PROVIDER
# ------------------------------------------------------------------------------
# Options: mock | openai | anthropic | gemini | groq
STORY_PROVIDER=mock
STORY_MODEL=gpt-4o-mini
OPENAI_API_KEY=placeholder_openai_api_key
ANTHROPIC_API_KEY=placeholder_anthropic_api_key
GEMINI_API_KEY=placeholder_gemini_api_key
GROQ_API_KEY=placeholder_groq_api_key

# ------------------------------------------------------------------------------
# AI IMAGE GENERATION PROVIDER
# ------------------------------------------------------------------------------
# Options: mock | openai | stability | replicate
IMAGE_PROVIDER=mock
IMAGE_MODEL=dall-e-3
STABILITY_API_KEY=placeholder_stability_api_key
REPLICATE_API_TOKEN=placeholder_replicate_token

# ------------------------------------------------------------------------------
# TEXT-TO-SPEECH (TTS) PROVIDER
# ------------------------------------------------------------------------------
# Options: mock | openai | elevenlabs | edge_tts
TTS_PROVIDER=mock
TTS_VOICE=alloy
ELEVENLABS_API_KEY=placeholder_elevenlabs_api_key
ELEVENLABS_VOICE_ID=placeholder_voice_id

# ------------------------------------------------------------------------------
# MEDIA PROCESSING TOOLS
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ------------------------------------------------------------------------------
# EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Options: console | smtp | sendgrid | resend
EMAIL_BACKEND=console
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=placeholder_smtp_user
SMTP_PASSWORD=placeholder_smtp_password
EMAIL_FROM=no-reply@yourlifeyourseries.com
RESEND_API_KEY=placeholder_resend_api_key

# ------------------------------------------------------------------------------
# BILLING & SUBSCRIPTIONS
# ------------------------------------------------------------------------------
# Options: mock | stripe
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=placeholder_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=placeholder_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=placeholder_stripe_webhook_secret

# ------------------------------------------------------------------------------
# NEXT.JS PUBLIC CONFIG (Client-Side)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
